; Saishin configuration
;
; Copy this file next to saishin.exe as saishin.ini, which is the name the
; program looks for; any other name is fine with --config <path>.
;
; Every section except [general] defines exactly one source.
; The two GitHub sections point at this project's own repository, which is what
; the repository's CI downloads; change owner and repo for your own sources.
; Relative paths are resolved against the directory containing this file.
; Values are read as written: a backslash is a path separator, not an escape,
; so C:\Saishin\tables is that directory.
; Comments start with ; or #

[general]
; Default download directory for sources that do not set their own 'out'.
out_dir = ./downloads

; Optional. Point at GitHub Enterprise instead of github.com.
; github_api_url = https://github.example.com/api/v3

; Optional. Name under which the token is filed in the OS secure store.
; keyring_service = saishin

; Optional. Which front end runs. true opens the selection window (for a
; desktop button); false keeps the run headless for a script or a scheduled
; task. A --gui / --no-gui switch on the command line wins over this key.
; Default: false.
; gui = true

; Optional. What the selection window does when the run ends. false keeps it
; open on its end state, with an OK button, so the log strip at the bottom
; stays readable. true closes the window as soon as the run ends. A run that
; stops with a half downloaded file asks about it first, and that question
; keeps the window open.
; Default: false.
; close_on_finish = true

; Optional. How many recent workflow runs (or releases) the --gui version
; dropdown offers per artifact. A source section may override this with its
; own 'releases'. Default: 10.
; releases = 10


; ---------------------------------------------------------------------------
; GitHub releases. The example points at this project's own repository, so
; saishin updates saishin. The repository is private, hence 'private = true'
; and a stored token ('saishin --login', once).
; No version is tagged yet, so this source has nothing to offer today; it
; starts delivering with the first release made by scripts/release.ps1.
; ---------------------------------------------------------------------------
[saishin_release]
type = github
owner = JockeJarre
repo = Saishin
private = true
tag = latest
filters = *.zip
out = ./builds/release
changelog = true
; version_suffix = true

; Uncomment to unpack what was downloaded.
; extract = *
; extract_to = ./builds/release/current
; strip_prefix = 1
; overwrite = true
; keep_zip = true
; extract_as gives the files it extracts names of your own, as
; 'glob -> name' pairs. The globs match the same entry paths 'extract' matches,
; the name is relative to extract_to, the first matching rule wins, and an entry
; no rule matches keeps its name from the archive.
; extract_as = *.exe -> bin/saishin.exe, docs/README* -> README.txt


; ---------------------------------------------------------------------------
; GitHub Actions artifacts: the binaries .github/workflows/ci.yml uploads on
; every push, one per platform. Reading artifacts always needs a token, so
; 'saishin --login' once. This is the source with something to download now:
; each run names its artifacts after the build, and the --gui dropdown offers
; the older runs of the same platform.
; ---------------------------------------------------------------------------
[saishin_builds]
type = actions
owner = JockeJarre
repo = Saishin
workflow = CI
runs = 10
; 'workflow' is a glob against the workflow name (the 'name:' line in the
; file); 'filters' match the artifact name, and the saved file gets .zip
; appended to it.
filters = *windows-x64*
out = ./builds/actions
; The artifact zip holds the executable and this file at its root.
extract = *
extract_to = ./builds/actions/current
keep_zip = true


; ---------------------------------------------------------------------------
; Anything else: plain URLs
; ---------------------------------------------------------------------------
[extra_media]
type = url
urls = https://example.invalid/media-pack.zip
out = ./extras
filters = *.zip
